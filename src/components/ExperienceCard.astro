---
import type { Experience } from '../data/experience';

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
---

<div class="relative pl-6 border-l-2 border-gray-200">
  <div class="absolute -left-[5px] top-1.5 w-2.5 h-2.5 rounded-full bg-white border-2 border-indigo-500"></div>

  <div class="mb-2 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
    <div>
      <span class="font-semibold text-gray-900 text-sm">{experience.role}</span>
      <span class="text-gray-300 mx-1.5">·</span>
      <span class="text-gray-600 text-sm">{experience.company}</span>
      <span class="text-gray-300 mx-1.5">·</span>
      <span class="text-gray-400 text-xs">{experience.location}</span>
    </div>
    <span class="text-xs text-gray-400 font-mono whitespace-nowrap">{experience.dates}</span>
  </div>

  <p class="text-gray-500 text-sm leading-relaxed mb-3">{experience.description}</p>

  <ul class="space-y-1.5">
    {
      experience.bullets.map((bullet) => (
        <li class="text-sm text-gray-600 flex gap-2.5 leading-relaxed">
          <span class="text-indigo-400 mt-0.5 flex-shrink-0 text-base leading-none">·</span>
          <span>{bullet}</span>
        </li>
      ))
    }
  </ul>
</div>
