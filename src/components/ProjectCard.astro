---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div
  class="bg-white border border-gray-200 rounded-xl p-6 flex flex-col gap-4 hover:border-indigo-200 hover:shadow-sm transition-all"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-base font-semibold text-gray-900">{project.name}</h3>
    <div class="flex gap-2 flex-shrink-0">
      {
        project.links.github && (
          <a
            href={project.links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-gray-500 hover:text-gray-900 border border-gray-200 px-2.5 py-1 rounded-md transition-colors"
          >
            GitHub
          </a>
        )
      }
      {
        project.links.demo && (
          <a
            href={project.links.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-gray-500 hover:text-gray-900 border border-gray-200 px-2.5 py-1 rounded-md transition-colors"
          >
            Demo
          </a>
        )
      }
    </div>
  </div>

  <p class="text-gray-500 text-sm leading-relaxed">{project.description}</p>

  <div class="flex flex-wrap gap-1.5">
    {
      project.stack.map((tech) => (
        <span class="bg-gray-100 text-gray-600 text-xs px-2.5 py-1 rounded-full font-medium">
          {tech}
        </span>
      ))
    }
  </div>

  <ul class="space-y-1.5">
    {
      project.highlights.map((point) => (
        <li class="text-sm text-gray-600 flex gap-2.5 leading-relaxed">
          <span class="text-indigo-400 mt-0.5 flex-shrink-0 text-base leading-none">·</span>
          <span>{point}</span>
        </li>
      ))
    }
  </ul>
</div>
