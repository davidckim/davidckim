---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { experiences } from '../data/experience';
import { skillGroups } from '../data/skills';
---

<Layout title="Resume — David Kim">
  <Navbar />
  <main class="flex-1">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6 mb-12">
        <div>
          <p class="text-indigo-600 font-medium text-sm mb-2">Resume</p>
          <h1 class="text-4xl font-bold text-gray-900 tracking-tight">David Kim</h1>
          <p class="text-gray-500 mt-1 text-sm">Senior Software Engineer · Los Angeles, CA</p>
          <p class="text-gray-500 text-sm mt-0.5">dckim320@gmail.com</p>
        </div>
        <a
          href="/david_kim_resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-indigo-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-indigo-700 transition-colors self-start whitespace-nowrap"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download PDF
        </a>
      </div>

      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 space-y-10">
          <div>
            <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4">Summary</h2>
            <p class="text-gray-600 text-sm leading-relaxed">
              Senior software engineer with 10+ years of experience. Mostly front-end work in
              React and TypeScript, with enough full-stack experience to be useful across the
              whole thing. I've worked in fintech, blockchain, SaaS, and e-commerce, co-founded
              a startup, and built a few side projects. I care about code quality and user
              experience in roughly equal measure.
            </p>
          </div>

          <div>
            <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-5">Experience</h2>
            <div>
              {
                experiences.map(({ role, company, dates }) => (
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 py-3 border-b border-gray-100 last:border-0">
                    <div>
                      <span class="text-gray-900 text-sm font-medium">{role}</span>
                      <span class="text-gray-300 mx-1.5">·</span>
                      <span class="text-gray-500 text-sm">{company}</span>
                    </div>
                    <span class="text-xs text-gray-400 font-mono whitespace-nowrap">{dates}</span>
                  </div>
                ))
              }
            </div>
            <a href="/experience" class="inline-block mt-4 text-sm text-indigo-600 hover:text-indigo-700 font-medium transition-colors">
              View full experience →
            </a>
          </div>
        </div>

        <aside class="space-y-8">
          <div>
            <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-5">Skills</h2>
            <div class="space-y-6">
              {skillGroups.map(({ category, skills }) => (
                <div>
                  <h3 class="text-xs font-medium text-gray-400 mb-1.5">{category}</h3>
                  <p class="text-sm text-gray-600 leading-relaxed">{skills.join(', ')}</p>
                </div>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
