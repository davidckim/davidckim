---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { experiences } from '../data/experience';
---

<Layout title="Experience — David Kim">
  <Navbar />
  <main class="flex-1">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <div class="mb-12">
        <p class="text-indigo-600 font-medium text-sm mb-2">Experience</p>
        <h1 class="text-4xl font-bold text-gray-900 tracking-tight mb-4">Where I've worked</h1>
        <p class="text-gray-500 text-sm max-w-xl leading-relaxed">
          A decade across product companies, a startup I co-founded, and an agency to start.
          Most of it front-end, some of it everything else.
        </p>
      </div>

      <div class="space-y-12 max-w-3xl">
        {experiences.map((exp) => <ExperienceCard experience={exp} />)}
      </div>

      <div class="mt-12 pt-8 border-t border-gray-200">
        <a
          href="/resume"
          class="inline-flex items-center gap-2 bg-indigo-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-indigo-700 transition-colors"
        >
          View Resume
        </a>
      </div>
    </div>

    <ContactCTA />
  </main>
  <Footer />
</Layout>
