---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact — David Kim">
  <Navbar />
  <main class="flex-1">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <div class="mb-12">
        <p class="text-indigo-600 font-medium text-sm mb-2">Contact</p>
        <h1 class="text-4xl font-bold text-gray-900 tracking-tight mb-4">Get in touch</h1>
        <p class="text-gray-500 text-sm max-w-lg leading-relaxed">
          I'm looking for my next senior engineering role, but I'm always happy to talk
          about interesting work or just make a connection. Best way to reach me is email
          and I'll get back to you.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-4 mb-14">
        <a
          href="mailto:dckim320@gmail.com"
          class="group border border-gray-200 rounded-xl p-5 hover:border-indigo-200 hover:shadow-sm transition-all"
        >
          <div class="w-8 h-8 bg-gray-50 rounded-lg flex items-center justify-center mb-3 group-hover:bg-indigo-50 transition-colors">
            <svg class="w-4 h-4 text-gray-500 group-hover:text-indigo-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="text-sm font-medium text-gray-900 mb-0.5">Email</p>
          <p class="text-xs text-gray-500">dckim320@gmail.com</p>
        </a>

        <a
          href="https://linkedin.com/in/davidckim320"
          target="_blank"
          rel="noopener noreferrer"
          class="group border border-gray-200 rounded-xl p-5 hover:border-indigo-200 hover:shadow-sm transition-all"
        >
          <div class="w-8 h-8 bg-gray-50 rounded-lg flex items-center justify-center mb-3 group-hover:bg-indigo-50 transition-colors">
            <svg class="w-4 h-4 text-gray-500 group-hover:text-indigo-600 transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z" />
              <circle cx="4" cy="4" r="2" />
            </svg>
          </div>
          <p class="text-sm font-medium text-gray-900 mb-0.5">LinkedIn</p>
          <p class="text-xs text-gray-500">linkedin.com/in/davidckim320</p>
        </a>

        <a
          href="https://github.com/davidckim"
          target="_blank"
          rel="noopener noreferrer"
          class="group border border-gray-200 rounded-xl p-5 hover:border-indigo-200 hover:shadow-sm transition-all"
        >
          <div class="w-8 h-8 bg-gray-50 rounded-lg flex items-center justify-center mb-3 group-hover:bg-indigo-50 transition-colors">
            <svg class="w-4 h-4 text-gray-500 group-hover:text-indigo-600 transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </div>
          <p class="text-sm font-medium text-gray-900 mb-0.5">GitHub</p>
          <p class="text-xs text-gray-500">github.com/davidckim</p>
        </a>
      </div>

      <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 max-w-lg">
        <p class="text-sm font-medium text-gray-900 mb-2">For recruiters</p>
        <p class="text-sm text-gray-600 leading-relaxed">
          I'm looking for senior front-end or full-stack roles at product-focused companies.
          I do my best work at places where engineering and product quality both matter.
          I reply to every message, so don't hesitate to reach out.
        </p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
