---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { projects } from '../data/projects';
---

<Layout title="Projects — David Kim">
  <Navbar />
  <main class="flex-1">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <div class="mb-12">
        <p class="text-indigo-600 font-medium text-sm mb-2">Projects</p>
        <h1 class="text-4xl font-bold text-gray-900 tracking-tight mb-4">Things I've built</h1>
        <p class="text-gray-500 text-sm max-w-xl leading-relaxed">
          A mix of side projects and a startup I co-founded. Some were built to solve a
          real problem, some just because the idea seemed worth trying. Either way, I
          learned something from all of them.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>

    <ContactCTA />
  </main>
  <Footer />
</Layout>
