---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SkillGroup from '../components/SkillGroup.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { skillGroups } from '../data/skills';
---

<Layout title="About — David Kim">
  <Navbar />
  <main class="flex-1">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <div class="mb-12">
        <p class="text-indigo-600 font-medium text-sm mb-2">About</p>
        <h1 class="text-4xl font-bold text-gray-900 tracking-tight">A bit about me</h1>
      </div>

      <div class="grid lg:grid-cols-3 gap-12 mb-16">
        <div class="lg:col-span-2 space-y-5 text-gray-600 leading-relaxed text-sm">
          <p>
            I'm a software engineer based in LA with about 10 years of experience building
            web products across the full stack. I started on the front-end and that's still
            where I spend most of my time, but I've built enough backend systems to be
            genuinely useful on both sides.
          </p>
          <p>
            On the front-end I work primarily in React and TypeScript. I care about getting
            state management right, writing async code that handles failure well, and
            building interfaces that make complicated systems feel simple to use.
          </p>
          <p>
            On the back-end I've worked with Node.js, GraphQL, Rails, and serverless
            architecture on AWS. I've designed APIs from scratch, built GraphQL gateways
            that unified multiple services, and worked with DynamoDB and PostgreSQL.
          </p>
          <p>
            Lately I've been building with LLMs. Less the hype, more the practical
            questions: how do you structure prompts so the output is reliable, how do you
            handle the cases where it isn't, how do you ship something AI-powered that
            doesn't feel brittle. I think there's a lot of genuinely useful software still
            to be built in that space.
          </p>
        </div>

        <aside class="space-y-7 text-sm">
          <div>
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Status</h3>
            <p class="text-gray-700">Open to new opportunities</p>
          </div>
          <div>
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Location</h3>
            <p class="text-gray-700">Los Angeles, CA</p>
          </div>
          <div>
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Reach me</h3>
            <a href="mailto:dckim320@gmail.com" class="text-indigo-600 hover:text-indigo-700 transition-colors block">
              dckim320@gmail.com
            </a>
            <a
              href="https://linkedin.com/in/davidckim"
              target="_blank"
              rel="noopener noreferrer"
              class="text-indigo-600 hover:text-indigo-700 transition-colors block mt-1"
            >
              LinkedIn
            </a>
            <a
              href="https://github.com/davidckim"
              target="_blank"
              rel="noopener noreferrer"
              class="text-indigo-600 hover:text-indigo-700 transition-colors block mt-1"
            >
              GitHub
            </a>
          </div>
          <div>
            <a href="/resume" class="text-indigo-600 hover:text-indigo-700 font-medium transition-colors">
              Download resume →
            </a>
          </div>
        </aside>
      </div>

      <div class="border-t border-gray-200 pt-12">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-10">Skills & Tools</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {skillGroups.map((group) => <SkillGroup group={group} />)}
        </div>
      </div>
    </div>

    <ContactCTA />
  </main>
  <Footer />
</Layout>
