---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SkillGroup from '../components/SkillGroup.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { skillGroups } from '../data/skills';
---

<Layout title="About — David Kim">
  <Navbar />
  <main class="flex-1">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <div class="mb-12">
        <p class="text-indigo-600 font-medium text-sm mb-2">About</p>
        <h1 class="text-4xl font-bold text-gray-900 tracking-tight">A bit about me</h1>
      </div>

      <div class="grid lg:grid-cols-3 gap-12 mb-16">
        <div class="lg:col-span-2 space-y-5 text-gray-600 leading-relaxed text-sm">
          <p>
            I'm a software engineer based in LA. I've been doing this for about 10 years,
            mostly on the front-end but not exclusively. I've worked in fintech, blockchain,
            B2B SaaS, and e-commerce, which is a roundabout way of saying I've built a lot
            of different things.
          </p>
          <p>
            Most of my time has been in React and TypeScript. I'm drawn to problems that
            look simple but aren't: state that gets complicated fast, async flows that have
            to be right, interfaces that make complicated systems feel straightforward.
            At Chia I was building wallet flows where you can't undo a transaction, which
            sharpens your thinking on UX pretty quickly.
          </p>
          <p>
            I co-founded Avocado Finance, a personal finance app in React Native. I was the
            only engineer, so every decision was mine: what to build first, how to structure
            the data, when to cut scope. Shipping that taught me more about product work
            than any job has.
          </p>
          <p>
            I've been spending time building with LLMs lately. WorthTheDownload started as
            something I wanted for myself. Finding a better way to decide whether a game is worth
            buying and turned into a decent project for learning how to structure prompts,
            handle outputs, and build something that holds up in production.
          </p>
        </div>

        <aside class="space-y-7 text-sm">
          <div>
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Status</h3>
            <p class="text-gray-700">Open to new opportunities</p>
          </div>
          <div>
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Location</h3>
            <p class="text-gray-700">Los Angeles, CA</p>
          </div>
          <div>
            <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Reach me</h3>
            <a href="mailto:dckim320@gmail.com" class="text-indigo-600 hover:text-indigo-700 transition-colors block">
              dckim320@gmail.com
            </a>
            <a
              href="https://linkedin.com/in/davidckim"
              target="_blank"
              rel="noopener noreferrer"
              class="text-indigo-600 hover:text-indigo-700 transition-colors block mt-1"
            >
              LinkedIn
            </a>
            <a
              href="https://github.com/davidckim"
              target="_blank"
              rel="noopener noreferrer"
              class="text-indigo-600 hover:text-indigo-700 transition-colors block mt-1"
            >
              GitHub
            </a>
          </div>
          <div>
            <a href="/resume" class="text-indigo-600 hover:text-indigo-700 font-medium transition-colors">
              Download resume →
            </a>
          </div>
        </aside>
      </div>

      <div class="border-t border-gray-200 pt-12">
        <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-10">Skills & Tools</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {skillGroups.map((group) => <SkillGroup group={group} />)}
        </div>
      </div>
    </div>

    <ContactCTA />
  </main>
  <Footer />
</Layout>
